# =========================================================================
# HUAI MONG SMART WATER COMMAND CENTER - ENVIRONMENT CONFIGURATION
# =========================================================================

# Application
APP_NAME="HUAI MONG SMART WATER COMMAND CENTER"
APP_ENV=production
TIMEZONE=Asia/Bangkok
PORT=8000

# Database (PostgreSQL / PostGIS for production; leave empty for SQLite standalone)
DATABASE_URL=postgresql://rid_admin:rid_password_change_in_production@localhost:5432/huaimong_db

# Security & CORS
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALLOWED_ORIGINS=*

# GIS & Telemetry API Connectors (Read-Only)
RID_TELEMETRY_API_ENDPOINT=https://api.rid.go.th/telemetry/v1
TMD_WEATHER_API_ENDPOINT=https://data.tmd.go.th/api/v1
ONWR_WATER_API_ENDPOINT=https://api.onwr.go.th/water-status/v1
